  "_meta": {
    "workflow_info": {
      "name": "Character Story Video Generator - Advanced (AnimateDiff)",
      "version": "2.0",
      "description": "Advanced workflow dengan AnimateDiff untuk generate video dari prompt text",
      "nodes_count": 11,
      "required_extensions": [
        "ComfyUI-AnimateDiff",
        "ComfyUI-Frame-Interpolation",
        "ComfyUI_VHS_VideoCombine"
      ],
      "instructions": [
        "1. Install required extensions di ComfyUI",
        "2. Pastikan AnimateDiff model tersedia",
        "3. Sesuaikan 'ckpt_name' dengan model Stable Diffusion Anda",
        "4. Customize prompt di node 2 (positive) dan node 3 (negative)",
        "5. Adjust context_length untuk durasi video yang berbeda",
        "6. Video akan di-generate langsung (node 10)",
        "7. Frame individual juga disimpan (node 11)"
      ]
    }
